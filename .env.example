# Copy to .env for Docker Compose. Local Python commands read environment variables, not this file automatically.
CAREERFORGE_MODE=production
CAREERFORGE_DATABASE_URL=postgresql+psycopg://careerforge:change-this-local-password@127.0.0.1:55432/careerforge_v15
POSTGRES_PASSWORD=change-this-local-password
CAREERFORGE_REDIS_BROKER_URL=redis://127.0.0.1:56379/0
CAREERFORGE_REDIS_CACHE_URL=redis://127.0.0.1:56380/0
CAREERFORGE_API_URL=http://127.0.0.1:8000
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL_NAME=
# Optional role-to-model map, same explicitly configured provider.
CAREERFORGE_ROLE_MODELS={}
CAREERFORGE_STRUCTURED_OUTPUT=auto
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=
GITHUB_TOKEN=
# Docker image ID/digest, e.g. sha256:...; a mutable tag is rejected by command approval.
CAREERFORGE_SANDBOX_IMAGE=
CAREERFORGE_MAX_OUTPUT_TOKENS=8192
CAREERFORGE_MODEL_TIMEOUT=120
# OTLP HTTP traces endpoint, e.g. http://collector:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
# Needed when installing a wheel outside the source checkout; source/Compose set it automatically.
# CAREERFORGE_PI_RUNTIME_DIR=/absolute/path/to/CareerForge_v1.5/coding-agent

# Optional new-session admission only; requires langgraph + knowledge-session-v2.
CAREERFORGE_LEARNING_GRAPH_VERSION=
