
# Configure an OpenAI-compatible provider and its actual model ID.
MODEL_NAME=your-provider-model-id
OPENAI_API_KEY=
OPENAI_BASE_URL=https://your-provider.example/v1
# S00 uses isolated local development infrastructure, not production credentials.
TEST_DATABASE_URL=postgresql://careerforge:careerforge_dev@127.0.0.1:55432/careerforge_test?connect_timeout=5
TEST_REDIS_URL=redis://127.0.0.1:56379/15

# Real requests run only after an explicit user action with a bounded call budget.
CAREERFORGE_REAL_AGENT_ENABLED=false
CAREERFORGE_MODEL_REASONING_EFFORT=low
CAREERFORGE_MODEL_MAX_OUTPUT_TOKENS=4096
CAREERFORGE_STUDY_MAX_OUTPUT_TOKENS=8192
