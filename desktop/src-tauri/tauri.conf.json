{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CareerForge",
  "version": "0.1.0",
  "identifier": "dev.careerforge.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "manager",
        "title": "CareerForge · 服务状态",
        "width": 1160,
        "height": 900,
        "minWidth": 860,
        "minHeight": 680
      }
    ],
    "security": {
      "capabilities": [
        "manager"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
